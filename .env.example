# Copy this file to .env and fill in real values before building.
# All values below are safe to expose in a client-side bundle (no secrets).

# Base path for GitHub Pages *project* sites, e.g. "/my-portfolio/".
# Leave as "/" for a user/organization page (username.github.io) or a custom domain.
VITE_BASE_PATH=/

# Optional: analytics id, contact form endpoint, etc. Add as needed.
# VITE_ANALYTICS_ID=
